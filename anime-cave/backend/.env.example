# Anime Cave backend env – copy to .env
HOST=127.0.0.1
PORT=8000
CORS_ORIGIN=http://127.0.0.1:5173
CACHE_DIR=./cache
DB_PATH=./anime_cave.db
DB_BACKUP_DIR=./backups
ARIA2C_PATH=aria2c
YTDLP_PATH=yt-dlp
DEFAULT_PLAYER=browser
LOG_LEVEL=info
EXTERNAL_DOWNLOADER=aria2c
CONCURRENCY=3
PER_HOST_LIMIT=4
RETRY_COUNT=3
BACKOFF_MS=1000
BANDWIDTH_LIMIT=0
